<MudDialog>
    <DialogContent>
        <div class="d-flex gap-4 mb-4">
            <MudNumericField T="int?" @bind-Value="this.numeroConcurso" Label="Concurso" Variant="Variant.Outlined"
                             Margin="Margin.Dense" Min="1" HideSpinButtons="true" Class="campo-concurso" />
            <MudSelect T="int" @bind-Value="this.dezenasPorJogo" Label="Dezenas por jogo" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Class="campo-dezenas-por-jogo">
                @for (int quantidade = RegrasLotofacil.MinimoDezenasPorJogo; quantidade <= RegrasLotofacil.MaximoDezenasPorJogo; quantidade++)
                {
                    int opcao = quantidade;
                    <MudSelectItem T="int" Value="opcao">@opcao</MudSelectItem>
                }
            </MudSelect>
        </div>
        <Volante Marcadas="this.marcadas" MarcadasChanged="this.TrocarMarcadas" Limite="this.dezenasPorJogo" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3 contagem">
            @FormatacaoJogo.Contagem(this.marcadas.Count, this.dezenasPorJogo, this.Custo)
        </MudText>
        <div class="mt-3">
            <CampoTeimosinha @bind-Ligada="this.teimosinha" @bind-Nome="this.nomeTeimosinha" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="this.Cancelar" Class="botao-cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="!this.PodeSalvar" OnClick="this.SalvarAsync"
                   Class="botao-salvar">
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>
