@page "/gerar-jogos"

<PageTitle>Gerar jogos · Lotofácil</PageTitle>

<div class="mb-4">
    <MudText Typo="Typo.h4" HtmlTag="h1">Gerar jogos</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Defina o concurso, a quantidade, a estratégia e as dezenas fixas
    </MudText>
</div>

<MudAlert Severity="Severity.Info" Class="mb-4 aviso">@Aviso</MudAlert>

@if (this.carregado && this.contexto is null)
{
    <MudText Class="sem-registros">@GeracaoJogosServico.MensagemBaseVazia</MudText>
}
else if (this.contexto is ContextoGeracao dados)
{
    <div class="grade-gerador">
        <MudPaper Class="pa-4 formulario" Elevation="1">
            <MudNumericField T="int?" @bind-Value="this.numeroConcurso" Label="Concurso" Variant="Variant.Outlined"
                             Margin="Margin.Dense" Min="1" HideSpinButtons="true" Class="campo-concurso mb-3" />
            <div class="linha-campos mb-3">
                <MudNumericField T="int" @bind-Value="this.quantidade" Label="Quantidade de jogos" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" Min="ParametrosGeracao.QuantidadeMinima"
                                 Max="ParametrosGeracao.QuantidadeMaxima" Class="campo-quantidade" />
                <MudSelect T="int" @bind-Value="this.dezenasPorJogo" @bind-Value:after="this.AjustarFiltros"
                           Label="Dezenas por jogo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="campo-dezenas-por-jogo">
                    @for (int opcao = RegrasLotofacil.MinimoDezenasPorJogo; opcao <= RegrasLotofacil.MaximoDezenasPorJogo; opcao++)
                    {
                        int valor = opcao;
                        <MudSelectItem T="int" Value="valor">@valor</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <MudSelect T="EstrategiaGeracao" @bind-Value="this.estrategia" Label="Estratégia" Variant="Variant.Outlined"
                       Margin="Margin.Dense" ToStringFunc="FormatacaoGeracao.Nome" Class="campo-estrategia">
                @foreach (EstrategiaGeracao opcao in Enum.GetValues<EstrategiaGeracao>())
                {
                    <MudSelectItem T="EstrategiaGeracao" Value="opcao">@FormatacaoGeracao.Nome(opcao)</MudSelectItem>
                }
            </MudSelect>
            <MudText Typo="Typo.caption" Class="mud-text-secondary descricao-estrategia">@FormatacaoGeracao.Descricao(this.estrategia)</MudText>

            <MudSelect T="int" @bind-Value="this.janela" Label="Janela da análise" Variant="Variant.Outlined"
                       Margin="Margin.Dense" ToStringFunc="this.NomeJanela" Class="campo-janela mt-3">
                <MudSelectItem T="int" Value="TodasAsJanelas">@this.NomeJanela(TodasAsJanelas)</MudSelectItem>
                @foreach (int opcao in EstatisticasServico.JanelasDisponiveis)
                {
                    <MudSelectItem T="int" Value="opcao">@this.NomeJanela(opcao)</MudSelectItem>
                }
            </MudSelect>

            <MudText Typo="Typo.subtitle2" Class="mt-4">Dezenas fixas e excluídas</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                Clique uma vez para fixar, de novo para excluir e outra vez para liberar.
            </MudText>
            <VolanteGeracao @bind-Fixas="this.fixas" @bind-Excluidas="this.excluidas" />
            <div class="d-flex align-center gap-2 mt-2">
                <MudText Typo="Typo.body2" Class="contagem-fixas">Fixas: @this.fixas.Count · Excluídas: @this.excluidas.Count</MudText>
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="this.Limpar" Class="botao-limpar">Limpar</MudButton>
            </div>

            <FiltrosPerfil @bind-Filtros="this.filtros" DezenasPorJogo="this.dezenasPorJogo" UltimoConcurso="dados.UltimoConcurso" />

            <MudText Typo="Typo.body1" Class="custo mt-4">@FormatacaoGeracao.Custo(this.quantidade, this.dezenasPorJogo, this.CustoGeracao)</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.Casino"
                       OnClick="this.GerarAsync" Disabled="this.gerando" Class="botao-gerar mt-2">
                Gerar jogos
            </MudButton>
        </MudPaper>

        <MudPaper Class="pa-4 gerados" Elevation="1">
            <MudText Typo="Typo.h6" HtmlTag="h2">Jogos gerados</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary subtitulo-lista mb-2">@FormatacaoGeracao.SubtituloLista(this.gerados.Count, this.CustoLista)</MudText>

            <div class="lista-gerados">
            @for (int indice = 0; indice < this.gerados.Count; indice++)
            {
                JogoGerado jogo = this.gerados[indice];
                string numero = FormatacaoJogo.NumeroJogo(indice + 1);
                <div class="linha-gerado">
                    <span class="numero-jogo">@numero</span>
                    <div class="bolas">
                        @foreach (int dezena in jogo.Dezenas)
                        {
                            <span class="@(this.fixas.Contains(dezena) ? "bola fixa" : "bola")">@dezena.ToString("00")</span>
                        }
                    </div>
                    <div class="perfil">
                        @if (jogo.Dezenas.Count > RegrasLotofacil.MinimoDezenasPorJogo)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Class="quantidade-dezenas">@FormatacaoJogo.QuantidadeDezenas(jogo.Dezenas.Count)</MudChip>
                        }
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="paridade">@FormatacaoGeracao.Paridade(jogo.Perfil)</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="soma">@FormatacaoGeracao.Soma(jogo.Perfil)</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="repetidas">@FormatacaoGeracao.Repetidas(jogo.Perfil, dados.UltimoConcurso)</MudChip>
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Class="botao-remover"
                                       aria-label="@($"Remover o jogo {numero}")" OnClick="() => this.Remover(jogo)" />
                    </div>
                </div>
            }
            </div>

            @if (this.gerados.Count > 0)
            {
                <div class="mt-3">
                    <CampoTeimosinha @bind-Ligada="this.teimosinha" @bind-Nome="this.nomeTeimosinha" />
                </div>
                <div class="d-flex flex-wrap justify-end gap-2 mt-3">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="this.GerarAsync" Disabled="this.gerando" Class="botao-gerar-novamente">
                        Gerar novamente
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                               OnClick="this.SalvarAsync"
                               Disabled="@(this.gerando || !CampoTeimosinha.Completo(this.teimosinha, this.nomeTeimosinha))"
                               Class="botao-salvar">
                        Salvar jogos
                    </MudButton>
                </div>
            }
        </MudPaper>
    </div>
}
