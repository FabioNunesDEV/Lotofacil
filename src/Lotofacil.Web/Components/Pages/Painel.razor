@page "/"

<PageTitle>Painel · Lotofácil</PageTitle>

<div class="d-flex flex-wrap align-center justify-space-between gap-4 mb-4">
    <div>
        <MudText Typo="Typo.h4" HtmlTag="h1">Painel</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary subtitulo">Resumo da base local e dos seus jogos</MudText>
    </div>
    <div class="d-flex flex-wrap align-center gap-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="this.AtualizarResultadosAsync" Disabled="this.Ocupada" Class="botao-atualizar">
            Atualizar resultados
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   Href="meus-jogos?novo=true" Class="botao-novo">
            Novo jogo
        </MudButton>
    </div>
</div>

@if (this.andamento is not null)
{
    <div class="andamento mb-4">
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-1" />
        <MudText Typo="Typo.body2">@this.andamento</MudText>
    </div>
}

@if (this.carregado && this.resumo is null)
{
    <MudText Class="sem-registros">
        @MensagemBaseVazia
        <MudLink Href="resultados" Class="link-resultados">Ir para Resultados</MudLink>
    </MudText>
}
else if (this.resumo is ResumoPainel dados)
{
    <div class="indicadores mb-4">
        <MudPaper Class="pa-4 indicador concursos-na-base" Elevation="1">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Concursos na base</MudText>
            <MudText Typo="Typo.h5" Class="valor">@dados.TotalConcursos.ToString("N0")</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary detalhe">@FormatacaoPainel.UltimoSorteio(dados.UltimoConcurso.Data)</MudText>
        </MudPaper>
        <MudPaper Class="pa-4 indicador proximo-concurso" Elevation="1">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Próximo concurso</MudText>
            <MudText Typo="Typo.h5" Class="valor">@dados.ProximoConcurso</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary detalhe">@FormatacaoPainel.Estimativa(dados.UltimoConcurso.EstimativaProximo)</MudText>
        </MudPaper>
        <MudPaper Class="pa-4 indicador jogos-aguardando" Elevation="1">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Jogos aguardando</MudText>
            <MudText Typo="Typo.h5" Class="valor">@dados.JogosAguardando.ToString("N0")</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary detalhe">@FormatacaoPainel.ConcursosAguardando(dados.ConcursosAguardando)</MudText>
        </MudPaper>
        <MudPaper Class="pa-4 indicador premios-a-receber" Elevation="1">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Prêmios a receber</MudText>
            <MudText Typo="Typo.h5" Class="valor">@FormatacaoJogo.Reais(dados.PremiosAReceber)</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary detalhe">Prazo: 90 dias após o sorteio</MudText>
        </MudPaper>
    </div>

    <div class="grade-2 mb-4">
        <MudPaper Class="pa-4 ultimo-resultado" Elevation="1">
            <div class="d-flex flex-wrap align-start justify-space-between gap-2 mb-3">
                <div>
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="titulo-ultimo">Último resultado · concurso @dados.UltimoConcurso.Numero</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary data-sorteio">@FormatacaoConcurso.DataComDiaSemana(dados.UltimoConcurso.Data)</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ganhadores"
                         Color="@(this.Rateio15.Ganhadores > 0 ? Color.Success : Color.Warning)">@FormatacaoPainel.Ganhadores15(this.Rateio15)</MudChip>
            </div>
            <div class="dezenas-sorteadas mb-3">
                <Dezenas Valores="dados.UltimoConcurso.Dezenas" />
            </div>
            <DetalheConcurso Concurso="dados.UltimoConcurso" />
        </MudPaper>

        <MudPaper Class="pa-4 destaques" Elevation="1">
            <div class="d-flex align-center justify-space-between gap-2 mb-3">
                <MudText Typo="Typo.h6" HtmlTag="h2">Destaques</MudText>
                <MudLink Href="estatisticas" Class="link-estatisticas">Estatísticas</MudLink>
            </div>
            <div class="grade-rankings">
                <RankingDezenas Titulo="Mais sorteadas" Ranking="dados.Estatisticas.MaisSorteadas" Classe="mais-sorteadas" />
                <RankingDezenas Titulo="Há mais tempo sem sair" Ranking="dados.Estatisticas.MaisAtrasadas" PorAtraso="true"
                                Classe="mais-atrasadas" />
            </div>
        </MudPaper>
    </div>

    <MudPaper Class="pa-4 jogos-ultimo-concurso" Elevation="1">
        <div class="d-flex align-center justify-space-between gap-2 mb-2">
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="titulo-jogos">Seus jogos no concurso @dados.UltimoConcurso.Numero</MudText>
            <MudLink Href="meus-jogos" Class="link-meus-jogos">Ver todos</MudLink>
        </div>
        @if (dados.JogosUltimoConcurso is GrupoJogos grupo)
        {
            @foreach (JogoConferido jogo in grupo.Jogos)
            {
                <div class="linha-jogo">
                    <span class="numero-jogo">@FormatacaoJogo.NumeroJogo(jogo.Numero)</span>
                    <BolasJogo Dezenas="jogo.Jogo.Dezenas" Sorteadas="dados.UltimoConcurso.Dezenas" />
                    <div class="resultado-jogo">
                        @if (jogo.Jogo.Dezenas.Count > RegrasLotofacil.MinimoDezenasPorJogo)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Class="quantidade-dezenas">@FormatacaoJogo.QuantidadeDezenas(jogo.Jogo.Dezenas.Count)</MudChip>
                        }
                        @if (jogo.Conferencia is ConferenciaJogo conferencia)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="acertos"
                                     Color="@(conferencia.Premiado ? Color.Success : Color.Default)">@FormatacaoJogo.Acertos(conferencia.Acertos)</MudChip>
                            <span class="premio">@FormatacaoJogo.Premio(conferencia.Premio)</span>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary sem-jogos">
                Nenhum jogo cadastrado para o concurso @dados.UltimoConcurso.Numero.
            </MudText>
        }
    </MudPaper>
}
