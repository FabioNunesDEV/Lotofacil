@page "/teimosinhas"

<PageTitle>Teimosinhas · Lotofácil</PageTitle>

<div class="mb-4">
    <MudText Typo="Typo.h4" HtmlTag="h1">Teimosinhas</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Jogos repetidos em todo concurso até você remover
    </MudText>
</div>

@if (this.carregado && this.ativas.Count == 0)
{
    <MudText Class="sem-registros">@FormatacaoTeimosinha.NenhumaAtiva</MudText>
}

@foreach (Teimosinha teimosinha in this.ativas)
{
    <MudPaper Class="pa-4 mb-4 teimosinha" Elevation="1" data-id="@teimosinha.Id">
        <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-2">
            <div>
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="nome-teimosinha">@teimosinha.Nome</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    <span class="desde">@FormatacaoTeimosinha.Desde(teimosinha.Desde ?? teimosinha.UltimoConcursoCriado)</span>
                    ·
                    <span class="custo">@FormatacaoTeimosinha.JogosECusto(teimosinha.Jogos.Count, this.Custo(teimosinha))</span>
                </MudText>
            </div>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Delete"
                       OnClick="() => this.RemoverAsync(teimosinha)" Class="botao-remover">
                Remover
            </MudButton>
        </div>
        @foreach (JogoTeimosinha jogo in teimosinha.Jogos)
        {
            <div class="jogo-teimosinha">
                <BolasJogo Dezenas="jogo.Dezenas" Sorteadas="null" />
                @if (jogo.Dezenas.Count > RegrasLotofacil.MinimoDezenasPorJogo)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="quantidade-dezenas">
                        @FormatacaoJogo.QuantidadeDezenas(jogo.Dezenas.Count)
                    </MudChip>
                }
            </div>
        }
    </MudPaper>
}
