@page "/configuracoes"

<PageTitle>Configurações · Lotofácil</PageTitle>

<div class="d-flex flex-wrap align-center justify-space-between gap-4 mb-4">
    <div>
        <MudText Typo="Typo.h4" HtmlTag="h1">Configurações</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Valores usados nos cálculos</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
               OnClick="this.SalvarAsync" Class="botao-salvar">
        Salvar
    </MudButton>
</div>

<div class="cartao-preco">
    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">Preço da aposta</MudText>
        <MudNumericField T="decimal?" @ref="this.campoPreco" @bind-Value="this.preco"
                         Validation="@(new Func<decimal?, string?>(ValidarPreco))"
                         Label="Aposta mínima (15 dezenas)" Variant="Variant.Outlined" Margin="Margin.Dense"
                         Format="0.00##" HideSpinButtons="true" Adornment="Adornment.Start" AdornmentText="R$"
                         Class="campo-preco mb-4" />
        <MudSimpleTable Dense="true" Elevation="0" Class="tabela-precos">
            <thead>
                <tr>
                    <th>Dezenas</th>
                    <th class="numero">Apostas equivalentes</th>
                    <th class="numero">Valor</th>
                </tr>
            </thead>
            <tbody>
                @for (int dezenas = RegrasLotofacil.MinimoDezenasPorJogo; dezenas <= RegrasLotofacil.MaximoDezenasPorJogo; dezenas++)
                {
                    <tr>
                        <td>@dezenas</td>
                        <td class="numero">@Jogo.CalcularQuantidadeApostas(dezenas).ToString("N0")</td>
                        <td class="numero">@this.Valor(dezenas)</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
</div>
