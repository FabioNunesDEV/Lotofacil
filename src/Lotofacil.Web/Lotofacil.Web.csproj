<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>lotofacil.ico</ApplicationIcon>
    <!-- Só os recursos em português das bibliotecas vão para a publicação. -->
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- Na geração do instalador (-p:Distribuicao=true), o app abre sem janela de console. -->
  <PropertyGroup Condition="'$(Distribuicao)' == 'true'">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <!-- O Windows Forms só serve à bandeja; sem os using globais, Color e Size continuam sendo os do MudBlazor. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <None Update="lotofacil.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lotofacil.Dominio\Lotofacil.Dominio.csproj" />
    <ProjectReference Include="..\Lotofacil.Aplicacao\Lotofacil.Aplicacao.csproj" />
    <ProjectReference Include="..\Lotofacil.Infraestrutura\Lotofacil.Infraestrutura.csproj" />
  </ItemGroup>

</Project>
